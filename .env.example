PORT=3001

# Must match backend PAYMENT_PROVIDER (paytm | payu | cashfree)
REACT_APP_PAYMENT_PROVIDER=paytm

# Customer-facing API (must match backend PAYMENT_PROVIDER for checkout)
REACT_APP_RESTAURANT_API_URL=http://localhost:3000

# Company details for payment gateway / legal pages — must match your registered business exactly
REACT_APP_COMPANY_LEGAL_NAME=
REACT_APP_COMPANY_ADDRESS=
REACT_APP_COMPANY_PHONE=
REACT_APP_COMPANY_GST=
REACT_APP_COMPANY_CIN=
REACT_APP_COMPANY_SUPPORT_EMAIL=
REACT_APP_COMPANY_WEBSITE=
