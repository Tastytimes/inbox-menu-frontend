PORT=3001

# Must match backend PAYMENT_PROVIDER (payu | cashfree)
REACT_APP_PAYMENT_PROVIDER=payu

# Customer-facing API (must match backend with PAYMENT_PROVIDER=payu for PayU checkout)
REACT_APP_RESTAURANT_API_URL=http://localhost:3000

# Company details for PayU / legal pages — must match your registered business exactly
REACT_APP_COMPANY_LEGAL_NAME=
REACT_APP_COMPANY_ADDRESS=
REACT_APP_COMPANY_PHONE=
REACT_APP_COMPANY_GST=
REACT_APP_COMPANY_CIN=
REACT_APP_COMPANY_SUPPORT_EMAIL=
REACT_APP_COMPANY_WEBSITE=
